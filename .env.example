# ==========================================
# SCMD PRO - ENVIRONMENT VARIABLES TEMPLATE
# Không được lưu secret thật vào file này.
# Copy thành .env và điền giá trị thật.
# ==========================================

# --- Core App Settings ---
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DISABLE_HMR=true
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- React / Frontend (Vite) ---
# Để trống khi frontend và backend cùng origin qua Node/Nginx/Docker Desktop.
# FRONTEND_* chỉ dùng lúc Docker build frontend; đổi các biến này phải rebuild image.
# Không dùng localhost cho production public.
FRONTEND_API_URL=
FRONTEND_SOCKET_URL=
VITE_API_URL=
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
# Docker dev backend mặc định chạy port 5000; nếu chạy npm run dev trực tiếp, đổi sang http://127.0.0.1:3000.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_APP_ENV=production

# --- Database Credentials ---
# docker-compose dùng 3 biến này để:
#   1. Khởi tạo PostgreSQL (service db)
#   2. Build DATABASE_URL nội bộ cho service app
DB_USER=scmduser
DB_PASSWORD=replace_me_with_db_password
DB_NAME=scmd_db
DATABASE_URL=
DIRECT_URL=
POSTGRES_USER=scmd_admin
POSTGRES_PASSWORD=replace_me_with_postgres_password
POSTGRES_DB=scmd_pro
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=replace_me_with_redis_password
REDIS_POOL_MAX=20
REDIS_POOL_MIN=5
REDIS_BULL_POOL_SIZE=5

# --- Authentication & Security (Bắt buộc) ---
# Server crash ngay khi thiếu 3 biến này ở NODE_ENV=production
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_strong_random_secret_min_64chars
INTERNAL_API_SECRET=replace_me_with_internal_api_secret_32bytes
DEVICE_SECRET=replace_me_with_device_secret_32bytes
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10
AUTH_COOKIE_SECURE=true
DESKTOP_AUTH_COOKIE_SECURE=false
DEV_AUTH_COOKIE_SECURE=false

# --- Database Seeding ---
# Production (NODE_ENV=production) BẮT BUỘC set SEED_SUPERADMIN_PASSWORD rõ ràng.
# Không dùng mật khẩu mặc định trong production; đổi/rotate superadmin ngay sau lần đăng nhập đầu tiên.
# Dev/test nếu để trống vẫn dùng fallback nội bộ để không phá local setup.
SEED_SUPERADMIN_PASSWORD=replace_me_with_strong_seed_superadmin_password
SEED_TENANT_ADMIN_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_COMMANDER_PASSWORD=
# Chỉ dùng cho desktop/local/dev khi cần đồng bộ lại mật khẩu demo sau khi DB đã tồn tại.
# Production luôn bỏ qua flag này để tránh reset tài khoản thật.
SEED_RESET_DEMO_PASSWORDS=false

# --- Auto Seed ---
# Được set tự động bởi reset-desktop.sh / Reset-Desktop.bat — không cần sửa
AUTO_SEED=false

# --- OpenTelemetry ---
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=scmd-pro-desktop
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_DEBUG=false

# --- Headless Browser (Puppeteer / PDF Export) ---
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
REPORT_ALLOWED_DOMAINS=localhost

# --- External Services (Tùy chọn) ---
GEMINI_API_KEY=
# Public contact anti-abuse.
# Production public traffic must keep CONTACT_LEAD_TURNSTILE_REQUIRED=true and set real keys.
# Desktop/local containers intentionally use DESKTOP_CONTACT_LEAD_TURNSTILE_REQUIRED=false by default.
VITE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CONTACT_LEAD_TURNSTILE_REQUIRED=true
DESKTOP_CONTACT_LEAD_TURNSTILE_REQUIRED=false
DEV_CONTACT_LEAD_TURNSTILE_REQUIRED=false
CONTACT_LEAD_TURNSTILE_TIMEOUT_MS=3000
CONTACT_LEAD_SPAM_RETENTION_DAYS=30
CONTACT_LEAD_RESOLVED_RETENTION_DAYS=730
# Legacy reCAPTCHA variables kept for backward compatibility only.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
PLATFORM_ADMIN_PHONE=
ZALO_ACCESS_TOKEN=
ZALO_OA_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Production evidence/report storage should use an S3-compatible provider such as Cloudflare R2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_PREFIX=
GRAFANA_PASSWORD=replace_me_with_grafana_password

# --- Security Hardening ---
FRAME_ANCESTORS='self'
PG_NOTIFY_CHANNEL=scmd_realtime_events
