# ==========================================
# SCMD PRO - ENVIRONMENT VARIABLES
# ==========================================
# [FIX C-05] CẢNH BÁO: File .env gốc chứa secrets thật đã bị commit vào git.
# Tất cả secrets đã được REDACT và thay thế bằng placeholder.
# ACTION REQUIRED:
#   1. Revoke toàn bộ secrets cũ ngay lập tức:
#      - Google Cloud Console: rotate GEMINI_API_KEY
#      - Cloudinary Dashboard: regenerate API Secret
#      - Rotate JWT_SECRET (invalidates all existing sessions)
#      - Đổi POSTGRES_PASSWORD trên production DB
#   2. Điền giá trị thật vào file này (KHÔNG commit lên git)
#   3. Xóa secrets khỏi git history:
#      git filter-branch --force --index-filter \
#        'git rm --cached --ignore-unmatch .env' \
#        --prune-empty --tag-name-filter cat -- --all
#      git push origin --force --all
# ==========================================

# --- Core App Settings ---
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,https://app.scmdpro.com

# --- React / Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_ENV=production

# --- Database Integration (PostgreSQL) ---
POSTGRES_USER=scmd_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=scmd_pro
DATABASE_URL=postgresql://scmd_admin:CHANGE_ME_STRONG_PASSWORD@pgbouncer:6432/scmd_pro?pgbouncer=true&schema=public
# [FIX M-04] DIRECT_URL cho Prisma migrations (bypass pgbouncer)
DIRECT_URL=postgresql://scmd_admin:CHANGE_ME_STRONG_PASSWORD@db:5432/scmd_pro?schema=public
DB_POOL_MAX=50
DB_POOL_MIN=5

# --- Redis ---
REDIS_URL=rediss://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_SENTINEL_NODES=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINEL_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_POOL_MAX=50
REDIS_POOL_MIN=10
REDIS_BULL_POOL_SIZE=10

# --- Authentication & Security ---
# QUAN TRỌNG: Sinh ngẫu nhiên bằng: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
INTERNAL_API_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
DEVICE_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# --- Database Seeding ---
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_TENANT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_GUARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- External Services ---
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# [FIX C-05] GEMINI_API_KEY đã bị revoke — điền key mới sau khi rotate
GEMINI_API_KEY=CHANGE_ME_AFTER_ROTATING_IN_GOOGLE_CLOUD_CONSOLE

PLATFORM_ADMIN_PHONE=0900000000
ZALO_ACCESS_TOKEN=
ZALO_OA_ID=

# --- Real-time & Events ---
PG_NOTIFY_CHANNEL=scmd_realtime_events

# --- Security Hardening ---
FRAME_ANCESTORS="'self'"

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=scmd-pro-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_DEBUG=false
OTEL_SDK_DISABLED=false

LOKI_URL=

# [FIX C-05] Đổi GRAFANA_PASSWORD mạnh hơn
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# --- PDF Service ---
REPORT_ALLOWED_DOMAINS=localhost,api,pdf-service,app.scmdpro.com

# --- Media Storage (Cloudinary) ---
# [FIX C-05] CLOUDINARY_API_SECRET đã bị revoke — điền credentials mới sau khi rotate
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME_AFTER_ROTATING_IN_CLOUDINARY_DASHBOARD
CLOUDINARY_API_SECRET=CHANGE_ME_AFTER_ROTATING_IN_CLOUDINARY_DASHBOARD
