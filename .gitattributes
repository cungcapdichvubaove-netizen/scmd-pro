# [FIX M-03] Enforce LF line endings cho Dockerfiles và shell scripts
# Ngăn CRLF gây lỗi "bad interpreter: /bin/sh^M" trên Linux/macOS
Dockerfile* text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.conf text eol=lf

# Binary files — không convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
