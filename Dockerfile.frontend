# ========================================
# STAGE 1: Build Environment
# ========================================
FROM node:22-alpine AS builder
WORKDIR /app

# Tối ưu cache cho dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy toàn bộ source code
COPY . /app

# Truyền biến môi trường tại thời điểm build (Vite require) [cite: 8]
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Thực hiện build frontend [cite: 8]
RUN npm run build

# STAGE 2: Runtime (Nginx)
FROM nginx:stable-alpine AS runner

# Tăng cường bảo mật Nginx
RUN rm -rf /etc/nginx/conf.d/*
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build output từ stage builder [cite: 8]
COPY --from=builder /app/dist /usr/share/nginx/html

# Cấu hình quyền hạn cho user non-root
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]