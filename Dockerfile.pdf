# [FIX NET-02]: node:20-alpine + apk install chromium
# Vấn đề: ghcr.io bị EOF (Azure Blob bị chặn), apt bị lỗi NOSPLIT (proxy intercept HTTP).
# Giải pháp: Alpine dùng apk qua dl-cdn.alpinelinux.org (HTTPS, ít bị proxy chặn hơn).
# Binary path: /usr/bin/chromium-browser — khớp chính xác với PUPPETEER_EXECUTABLE_PATH trong .env.
FROM node:20-alpine

USER root
WORKDIR /app

# Cài Chromium + dependencies cần thiết qua apk (Alpine Package Keeper)
# chromium: trình duyệt headless, udev: device events, ttf-freefont: font cơ bản
# wget: cần cho healthcheck (wget -qO- http://localhost:3001/health)
RUN apk add --no-cache \
    chromium \
    udev \
    ttf-freefont \
    wget

# PUPPETEER_EXECUTABLE_PATH không set ở đây vì .env đã có:
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Alpine chromium binary nằm đúng tại /usr/bin/chromium-browser → khớp .env
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# [FIX PERF]: Chỉ copy package.json của PDF service (2 deps: express + puppeteer)
COPY scripts/package.json ./
RUN npm install --ignore-scripts

# Chỉ copy file cần thiết
COPY scripts/pdf-server.js ./scripts/

ENV PORT=3001
EXPOSE 3001

# Tạo user non-root pptruser (tương đương base image cũ)
RUN addgroup -S pptruser && adduser -S -G pptruser pptruser \
  && mkdir -p /home/pptruser/Downloads \
  && chown -R pptruser:pptruser /home/pptruser \
  && chown -R pptruser:pptruser /app

USER pptruser

CMD ["node", "scripts/pdf-server.js"]
