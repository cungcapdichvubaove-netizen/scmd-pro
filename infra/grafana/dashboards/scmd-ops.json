  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Latency p95/p99",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, tenantId))",
          "legendFormat": "p95 - {{tenantId}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, tenantId))",
          "legendFormat": "p99 - {{tenantId}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "BullMQ Queue Depth",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "bullmq_queue_depth",
          "legendFormat": "{{queue}} - {{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "DB Pool Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "prisma_pool_active_connections",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "prisma_pool_idle_connections",
          "legendFormat": "Idle Connections"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Redis Hit Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "Hit Rate"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ],
