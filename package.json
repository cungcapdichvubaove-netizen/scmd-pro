{
  "name": "scmdpro-backend",
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 npm run db:generate && npm run build:frontend && npm run build:server && npm run build:backend",
    "build:frontend": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:server": "NODE_OPTIONS=--max-old-space-size=4096 esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --target=node22 --packages=external",
    "build:backend": "NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.backend.json",
    "start": "node --max-old-space-size=2048 dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/server/modules/auth/seed.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/s3-presigned-post": "^3.1043.0",
