model ShiftSchedule {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  contractId      String   @map("contract_id")
  guardPostId     String?  @map("guard_post_id")
  date            String   @map("date") // YYYY-MM-DD
  shiftType       String   @map("shift_type") // MORNING, AFTERNOON, NIGHT
  startTime       String   @map("start_time") // HH:mm
  endTime         String   @map("end_time") // HH:mm
  requiredCount   Int      @map("required_count")
  positionName    String   @map("position_name")
  siteId          String   @map("site_id")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]
  assignments       ShiftAssignment[]
