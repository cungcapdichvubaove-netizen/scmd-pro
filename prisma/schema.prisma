model MonthlyAcceptanceReport {
  id                        String   @id @default(uuid()) @map("id")
  tenantId                  String   @map("tenant_id")
  vendorId                  String   @map("vendor_id")
  contractId                String?  @map("contract_id")
  contractVersionId         String?  @map("contract_version_id")
  siteId                    String?  @map("site_id")
  month                     String   @map("month")
  status                    String   @default("DRAFT") @map("status")
  scorecardId               String?  @map("scorecard_id")
  revisionNumber            Int      @default(1) @map("revision_number")
  revisionRootId            String?  @map("revision_root_id")
  previousRevisionId        String?  @unique @map("previous_revision_id")
  supersededByReportId      String?  @unique @map("superseded_by_report_id")
  supersededAt              DateTime? @map("superseded_at")
  supersededBy              String?  @map("superseded_by")
  generatedAt               DateTime @default(now()) @map("generated_at")
  generatedBy               String?  @map("generated_by")
  finalizedAt               DateTime? @map("finalized_at")
  finalizedBy               String?  @map("finalized_by")
  totalPenaltyAmount        Decimal  @default(0) @map("total_penalty_amount")
  totalConfirmedViolations  Int      @default(0) @map("total_confirmed_violations")
  totalPendingViolations    Int      @default(0) @map("total_pending_violations")
  summary                   Json?    @map("summary")
  contractSnapshot          Json?    @map("contract_snapshot")
  vendorSnapshot            Json     @map("vendor_snapshot")
  siteSnapshot              Json?    @map("site_snapshot")
  slaPolicySnapshot         Json?    @map("sla_policy_snapshot")
  penaltyPolicySnapshot     Json?    @map("penalty_policy_snapshot")
  scoreFormulaVersion       String   @default("monthly-acceptance-v1") @map("score_formula_version")
  violationSnapshots        Json     @map("violation_snapshots")
  evidenceSnapshots         Json     @map("evidence_snapshots")
  penaltyCalculationDetails Json     @map("penalty_calculation_details")
  generatedDataHash         String   @map("generated_data_hash")
  exportPdfJobId            String?  @map("export_pdf_job_id")
  exportExcelJobId          String?  @map("export_excel_job_id")
  exportPdfAttachmentId     String?  @map("export_pdf_attachment_id")
  exportExcelAttachmentId   String?  @map("export_excel_attachment_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  contractVersion    ContractVersion?         @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  previousRevision   MonthlyAcceptanceReport?  @relation("MonthlyAcceptanceReportRevisionChain", fields: [previousRevisionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nextRevision       MonthlyAcceptanceReport?  @relation("MonthlyAcceptanceReportRevisionChain")
  supersededByReport MonthlyAcceptanceReport?  @relation("MonthlyAcceptanceReportSupersede", fields: [supersededByReportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedesReports  MonthlyAcceptanceReport[] @relation("MonthlyAcceptanceReportSupersede")
  penaltyItems       PenaltyItem[]
  disputes           ViolationDispute[]

  @@unique([tenantId, vendorId, contractId, siteId, month, revisionNumber])
  @@index([tenantId, month])
  @@index([tenantId, vendorId, month])
  @@index([tenantId, contractVersionId])
  @@index([tenantId, revisionRootId])
  @@map("monthly_acceptance_reports")
}

