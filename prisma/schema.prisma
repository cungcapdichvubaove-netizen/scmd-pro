// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // [FIX M-04] directUrl bypass pgbouncer cho Prisma migrations
  // Prisma migrate không tương thích với pgbouncer transaction mode
  directUrl = env("DIRECT_URL")
}

model Task {
  id          String    @id @default(uuid()) @map("id")
  tenantId    String    @map("tenant_id")
  title       String    @map("title")
  description String?   @map("description")
  status      String    @default("PENDING") @map("status") // PENDING, IN_PROGRESS, COMPLETED
  priority    String    @default("MEDIUM") @map("priority") // LOW, MEDIUM, HIGH
  dueDate     DateTime? @map("due_date")
  assigneeId  String?   @map("assignee_id")
  createdBy   String?   @map("created_by")
  metadata    Json?     @map("metadata")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([assigneeId, status])
  @@index([createdAt])
  @@map("tasks")
}

model Checkpoint {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  name      String   @map("name")
  status    String   @default("active") @map("status")
  siteId    String?  @map("site_id")
  guardPostId String? @map("guard_post_id")
  qrHash    String   @default("") @map("qr_hash")
  checkItems Json?    @map("check_items")
  // PostGIS geography column - defined as Unsupported in Prisma DSL for manual raw queries
  location  Unsupported("geography(Point, 4326)")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // ── Learning Mode / Benchmark fields ──
  benchmarkTravelTime   Int?      @map("benchmark_travel_time")
  benchmarkWorkDuration Int?      @map("benchmark_work_duration")
  benchmarkTolerancePct Int?      @default(20) @map("benchmark_tolerance_pct")
  benchmarkRecordedBy   String?   @map("benchmark_recorded_by")
  benchmarkRecordedAt   DateTime? @map("benchmark_recorded_at")
  benchmarkSessionCount Int?      @default(0) @map("benchmark_session_count")

  logs      PatrolLog[]
  routeCheckpoints PatrolRouteCheckpoint[]
  deviations PatrolBenchmarkDeviation[]
  benchmarkSessions CheckpointBenchmarkSession[]
  site      Site?    @relation(fields: [siteId], references: [id])
  guardPost GuardPost? @relation(fields: [guardPostId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@index([tenantId, guardPostId])
  @@index([createdAt])
  @@map("checkpoints")
}

model CheckpointBenchmarkSession {
  id             String     @id @default(uuid()) @map("id")
  tenantId       String     @map("tenant_id")
  checkpointId   String     @map("checkpoint_id")
  travelTime     Int        @map("travel_time")
  workDuration   Int        @map("work_duration")
  lat            Float?     @map("lat")
  lon            Float?     @map("lon")
  recordedBy     String     @map("recorded_by")
  createdAt      DateTime   @default(now()) @map("created_at")

  checkpoint     Checkpoint @relation(fields: [checkpointId], references: [id])

  @@index([checkpointId])
  @@index([tenantId])
  @@map("checkpoint_benchmark_sessions")
}

model PatrolBenchmarkDeviation {
  id            String   @id @default(uuid()) @map("id")
  tenantId      String   @map("tenant_id")
  patrolLogId   String   @map("patrol_log_id")
  checkpointId  String   @map("checkpoint_id")
  staffId       String   @map("staff_id")

  actualTravelTime    Int?    @map("actual_travel_time")
  actualWorkDuration  Int?    @map("actual_work_duration")
  expectedTravelTime  Int?    @map("expected_travel_time")
  expectedWorkDuration Int?   @map("expected_work_duration")
  tolerancePct        Int?    @map("tolerance_pct")

  travelDeviationPct  Decimal? @map("travel_deviation_pct")
  workDeviationPct    Decimal? @map("work_deviation_pct")
  isCompliant         Boolean? @map("is_compliant")
  violationType       String?  @map("violation_type")
  severity            String   @default("low") @map("severity")

  createdAt DateTime @default(now()) @map("created_at")

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, staffId])
  @@map("patrol_benchmark_deviations")
}

model Staff {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  username  String   @unique @map("username")
  email     String   @unique @map("email")
  password  String   @default("") @map("password")
  fullName  String   @map("full_name")
  staffId   String?  @map("staff_id")
  phone     String?  @map("phone")
  role      String   @default("guard") @map("role")
  assignedVendorId String? @map("assigned_vendor_id")
  assignedSiteId String? @map("assigned_site_id")
  assignedContractId String? @map("assigned_contract_id")
  status    String   @default("active") @map("status")
  tokenVersion Int     @default(1) @map("token_version")
  qualifications String[] @default([]) @map("qualifications")
  
  // ── Smart Recognition & Credentials ──
  idNumber      String?  @unique @map("id_number")
  licenseNumber String?  @map("license_number")
  idExpiry      DateTime? @map("id_expiry")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  logs      PatrolLog[]
  attendanceRecords AttendanceRecord[]
  shiftAssignments ShiftAssignment[]
  patrolAssignments PatrolAssignment[]
  shiftSessions ShiftSession[]
  patrolSessions PatrolSession[]
  performanceMetrics StaffPerformanceMetric[]
  disciplinaryActions DisciplinaryAction[]
  reportedIncidents Incident[] @relation("IncidentReporter")
  assignedIncidents Incident[] @relation("IncidentAssignee")
  resolvedIncidents Incident[] @relation("IncidentResolver")
  approvedIncidents Incident[] @relation("IncidentApprover")
  closedIncidents Incident[] @relation("IncidentCloser")
  benchmarkDeviations PatrolBenchmarkDeviation[]

  @@unique([tenantId, staffId])
  @@index([tenantId, status])
  @@index([tenantId, id])
  @@index([role])
  @@index([tenantId, assignedVendorId])
  @@index([tenantId, assignedSiteId])
  @@index([tenantId, assignedContractId])
  @@index([tenantId, staffId])
  @@index([idNumber])
  @@map("staff")
}

model StaffPerformanceMetric {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  staffId         String   @map("staff_id")
  period          String   @map("period") // YYYY-MM
  trustScore      Float    @map("trust_score")
  attendanceRate  Float    @map("attendance_rate")
  missedPoints    Int      @map("missed_points")
  sosCount        Int      @map("sos_count")
  createdAt       DateTime @default(now()) @map("created_at")

  staff           Staff    @relation(fields: [staffId], references: [id])

  @@unique([tenantId, staffId, period])
  @@index([tenantId])
  @@index([staffId, period])
  @@map("staff_performance_metrics")
}

model DisciplinaryAction {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  staffId         String   @map("staff_id")
  type            String   @map("type") // LATE, UNIFORM, ABANDON, etc.
  description     String   @map("description")
  severity        String   @default("LOW") @map("severity")
  evidenceUris    String[] @default([]) @map("evidence_uris")
  actionTaken     String?  @map("action_taken")
  occurredAt      DateTime @default(now()) @map("occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  staff           Staff    @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([staffId])
  @@map("disciplinary_actions")
}

model Audit {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  auditorId       String   @map("auditor_id") // staffId of the auditor
  siteId          String   @map("site_id")
  checklist       Json     @map("checklist") // [{ item: string, status: 'PASS' | 'FAIL', note: string }]
  overallScore    Float    @map("overall_score")
  evidenceUris    String[] @default([]) @map("evidence_uris")
  auditorSignature String? @map("auditor_signature")
  contractorRepresentative String? @map("contractor_representative")
  locationLat     Float?   @map("location_lat")
  locationLng     Float?   @map("location_lng")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([siteId])
  @@map("audits")
}

model AttendanceRecord {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  staffId     String   @map("staff_id")
  type        String   @map("type") // CHECK_IN, CHECK_OUT, LIVENESS
  location    Json?    @map("location") // { lat, lon }
  imageUri    String?  @map("image_uri")
  isValid     Boolean  @default(true) @map("is_valid")
  notes       String?  @map("notes")

  shiftScheduleId   String?   @map("shift_schedule_id")
  shiftSessionId    String?   @map("shift_session_id")
  checkInAt         DateTime? @map("check_in_at")
  checkOutAt        DateTime? @map("check_out_at")
  workedMinutes     Int?      @map("worked_minutes")
  lateMinutes       Int?      @default(0) @map("late_minutes")
  earlyLeaveMinutes Int?      @default(0) @map("early_leave_minutes")
  metadata          Json?     @map("metadata")

  createdAt   DateTime @default(now()) @map("created_at")

  staff       Staff    @relation(fields: [staffId], references: [id])
  shiftSchedule ShiftSchedule? @relation(fields: [shiftScheduleId], references: [id])
  shiftSession  ShiftSession? @relation(fields: [shiftSessionId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, id])
  @@index([tenantId, shiftScheduleId])
  @@index([tenantId, shiftSessionId])
  @@index([staffId, createdAt(sort: Desc)])
  @@map("attendance_records")
}

model PatrolLog {
  id           String     @id @default(uuid()) @map("id")
  tenantId     String     @map("tenant_id")
  staffId      String     @map("staff_id")
  checkpointId String     @map("checkpoint_id")
  patrolSessionId String?  @map("patrol_session_id")
  routeCheckpointId String? @map("route_checkpoint_id")
  sequenceActual Int?      @map("sequence_actual")
  scannedAt    DateTime?   @map("scanned_at")
  photoEvidenceIds String[] @default([]) @map("photo_evidence_ids")
  note         String?      @map("note")
  validationStatus String  @default("VALID") @map("validation_status")
  exceptionCodes String[]  @default([]) @map("exception_codes")
  metadata     Json?      @map("metadata")
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
  staff        Staff      @relation(fields: [staffId], references: [id])
  patrolSession PatrolSession? @relation(fields: [patrolSessionId], references: [id])
  routeCheckpoint PatrolRouteCheckpoint? @relation(fields: [routeCheckpointId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, id])
  @@index([tenantId, staffId, createdAt(sort: Desc)])
  @@index([tenantId, patrolSessionId, createdAt])
  @@index([tenantId, validationStatus])
  @@map("patrol_logs")
}

model PatrolRoute {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  name            String   @map("name")
  description     String?  @map("description")
  siteId          String?  @map("site_id")
  contractId      String?  @map("contract_id")
  vendorId        String?  @map("vendor_id")
  positionName    String?  @map("position_name")
  status          String   @default("DRAFT") @map("status")
  estimatedMinutes Int?    @map("estimated_minutes")
  requiredCompletionPercent Int @default(100) @map("required_completion_percent")
  repeatIntervalMinutes Int? @map("repeat_interval_minutes")
  complianceConfig Json?   @map("compliance_config")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  checkpoints     PatrolRouteCheckpoint[]
  assignments     PatrolAssignment[]
  sessions        PatrolSession[]

  @@index([tenantId, status])
  @@index([tenantId, siteId])
  @@index([tenantId, contractId])
  @@index([tenantId, vendorId])
  @@map("patrol_routes")
}

model PatrolRouteCheckpoint {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  routeId         String   @map("route_id")
  checkpointId    String   @map("checkpoint_id")
  guardPostId     String?  @map("guard_post_id")
  sequence        Int      @map("sequence")
  isRequired      Boolean  @default(true) @map("is_required")
  minOffsetMinutes Int?    @map("min_offset_minutes")
  maxOffsetMinutes Int?    @map("max_offset_minutes")
  geoRadiusMeters Int      @default(50) @map("geo_radius_meters")
  gpsRequired     Boolean  @default(true) @map("gps_required")
  photoRequired   Boolean  @default(false) @map("photo_required")
  noteRequired    Boolean  @default(false) @map("note_required")
  createdAt       DateTime @default(now()) @map("created_at")

  route           PatrolRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  checkpoint      Checkpoint  @relation(fields: [checkpointId], references: [id])
  guardPost       GuardPost?  @relation(fields: [guardPostId], references: [id])
  logs            PatrolLog[]

  @@unique([tenantId, routeId, sequence])
  @@unique([tenantId, routeId, checkpointId])
  @@index([tenantId, checkpointId])
  @@index([tenantId, guardPostId])
  @@map("patrol_route_checkpoints")
}

model PatrolAssignment {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  routeId         String   @map("route_id")
  staffId         String   @map("staff_id")
  shiftScheduleId String?  @map("shift_schedule_id")
  contractId      String?  @map("contract_id")
  vendorId        String?  @map("vendor_id")
  assignmentDate  String?  @map("assignment_date")
  startAt         DateTime? @map("start_at")
  endAt           DateTime? @map("end_at")
  status          String   @default("PLANNED") @map("status")
  assignedBy      String?  @map("assigned_by")
  metadata        Json?    @map("metadata")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  route           PatrolRoute @relation(fields: [routeId], references: [id])
  staff           Staff @relation(fields: [staffId], references: [id])
  shiftSchedule   ShiftSchedule? @relation(fields: [shiftScheduleId], references: [id])
  shiftSessions   ShiftSession[]
  patrolSessions  PatrolSession[]

  @@index([tenantId, staffId, status])
  @@index([tenantId, shiftScheduleId])
  @@index([tenantId, contractId])
  @@index([tenantId, vendorId])
  @@index([tenantId, assignmentDate])
  @@map("patrol_assignments")
}

model ShiftSession {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  staffId         String   @map("staff_id")
  shiftScheduleId String?  @map("shift_schedule_id")
  patrolAssignmentId String? @map("patrol_assignment_id")
  status          String   @default("PENDING_REVIEW") @map("status")
  openedAt        DateTime @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  checkInAttendanceId String? @map("check_in_attendance_id")
  checkOutAttendanceId String? @map("check_out_attendance_id")
  exceptionCodes  String[] @default([]) @map("exception_codes")
  metadata        Json?    @map("metadata")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  staff           Staff @relation(fields: [staffId], references: [id])
  shiftSchedule   ShiftSchedule? @relation(fields: [shiftScheduleId], references: [id])
  patrolAssignment PatrolAssignment? @relation(fields: [patrolAssignmentId], references: [id])
  attendanceRecords AttendanceRecord[]
  patrolSessions  PatrolSession[]

  @@index([tenantId, staffId, status])
  @@index([tenantId, shiftScheduleId])
  @@index([tenantId, patrolAssignmentId])
  @@map("shift_sessions")
}

model PatrolSession {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  routeId         String   @map("route_id")
  staffId         String   @map("staff_id")
  vendorId        String?  @map("vendor_id")
  contractId      String?  @map("contract_id")
  siteId          String?  @map("site_id")
  shiftSessionId  String?  @map("shift_session_id")
  patrolAssignmentId String? @map("patrol_assignment_id")
  status          String   @default("IN_PROGRESS") @map("status")
  startedAt       DateTime @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  expectedCheckpointCount Int @default(0) @map("expected_checkpoint_count")
  scannedCheckpointCount Int @default(0) @map("scanned_checkpoint_count")
  completionPercent Float @default(0) @map("completion_percent")
  missedCheckpointCount Int @default(0) @map("missed_checkpoint_count")
  lateCheckpointCount Int @default(0) @map("late_checkpoint_count")
  outOfOrderCount Int @default(0) @map("out_of_order_count")
  gpsViolationCount Int @default(0) @map("gps_violation_count")
  evidenceMissingCount Int @default(0) @map("evidence_missing_count")
  complianceScore Float? @map("compliance_score")
  exceptionSummary Json? @map("exception_summary")
  metadata        Json?  @map("metadata")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  route           PatrolRoute @relation(fields: [routeId], references: [id])
  staff           Staff @relation(fields: [staffId], references: [id])
  shiftSession    ShiftSession? @relation(fields: [shiftSessionId], references: [id])
  patrolAssignment PatrolAssignment? @relation(fields: [patrolAssignmentId], references: [id])
  logs            PatrolLog[]

  @@index([tenantId, staffId, status])
  @@index([tenantId, routeId])
  @@index([tenantId, vendorId])
  @@index([tenantId, contractId])
  @@index([tenantId, siteId])
  @@index([tenantId, shiftSessionId])
  @@index([tenantId, patrolAssignmentId])
  @@index([tenantId, complianceScore])
  @@map("patrol_sessions")
}

model ViolationEvent {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  vendorId        String?  @map("vendor_id")
  contractId      String?  @map("contract_id")
  siteId          String?  @map("site_id")
  guardPostId     String?  @map("guard_post_id")
  staffId         String?  @map("staff_id")
  patrolSessionId String?  @map("patrol_session_id")
  sourceType      String   @map("source_type")
  violationType   String   @map("violation_type")
  severity        String   @default("MEDIUM") @map("severity")
  status          String   @default("PENDING_REVIEW") @map("status")
  occurredAt      DateTime @default(now()) @map("occurred_at")
  idempotencyKey  String   @map("idempotency_key")
  evidence        Json?    @map("evidence")
  penaltyAmount   Decimal  @default(0) @map("penalty_amount")
  metadata        Json?    @map("metadata")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, vendorId, occurredAt(sort: Desc)])
  @@index([tenantId, contractId, occurredAt(sort: Desc)])
  @@index([tenantId, patrolSessionId])
  @@map("violation_events")
}

model Incident {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  staffId     String   @map("staff_id") // ID of the person who reported
  vendorId    String?  @map("vendor_id")
  contractId  String?  @map("contract_id")
  siteId      String?  @map("site_id")
  type        String   @map("type")
  severity    IncidentSeverity @default(LOW) @map("severity")
  severityWeight Int @default(1) @map("severity_weight")
  description String   @map("description")
  imageUri    String?  @map("image_uri")
  location    Json?    @map("location")
  status      IncidentStatus @default(REPORTED) @map("status")
  
  assignedToId String? @map("assigned_to_id")
  resolutionNotes String? @map("resolution_notes")
  resolutionImages String[] @default([]) @map("resolution_images")
  slaDeadline DateTime? @map("sla_deadline")
  slaBreached Boolean @default(false) @map("sla_breached")
  slaMinutes Int? @map("sla_minutes")
  responseDueAt DateTime? @map("response_due_at")
  resolutionDueAt DateTime? @map("resolution_due_at")
  responseAcknowledgedAt DateTime? @map("response_acknowledged_at")
  resolutionSubmittedAt DateTime? @map("resolution_submitted_at")
  requiredEvidenceTypes String[] @default([]) @map("required_evidence_types")
  escalatedAt DateTime? @map("escalated_at")
  resolvedById String? @map("resolved_by_id")
  approvedById String? @map("approved_by_id")
  closedById String? @map("closed_by_id")
  reopenedAt DateTime? @map("reopened_at")
  reopenReason String? @map("reopen_reason")
  
  reportedAt  DateTime @default(now()) @map("reported_at")
  investigatingAt DateTime? @map("investigating_at")
  resolvedAt  DateTime? @map("resolved_at")
  closedAt    DateTime? @map("closed_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reporter    Staff    @relation("IncidentReporter", fields: [staffId], references: [id])
  assignee    Staff?   @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  resolver    Staff?   @relation("IncidentResolver", fields: [resolvedById], references: [id])
  approver    Staff?   @relation("IncidentApprover", fields: [approvedById], references: [id])
  closer      Staff?   @relation("IncidentCloser", fields: [closedById], references: [id])
  vendor      Vendor?   @relation("IncidentVendor", fields: [vendorId], references: [id])
  contract    Contract? @relation("IncidentContract", fields: [contractId], references: [id])
  site        Site?     @relation("IncidentSite", fields: [siteId], references: [id])
  timeline    IncidentTimeline[]
  evidences   IncidentEvidence[]

  @@index([tenantId, status])
  @@index([tenantId, status, slaDeadline])
  @@index([tenantId, status, responseDueAt])
  @@index([tenantId, status, resolutionDueAt])
  @@index([tenantId, vendorId, reportedAt(sort: Desc)])
  @@index([tenantId, contractId, reportedAt(sort: Desc)])
  @@index([tenantId, siteId, reportedAt(sort: Desc)])
  @@index([tenantId, slaBreached])
  @@index([staffId, createdAt(sort: Desc)])
  @@index([tenantId, staffId, type, createdAt(sort: Desc)])
  @@index([tenantId, severityWeight, reportedAt(sort: Desc)])
  @@index([tenantId, reportedAt(sort: Desc)])
  @@map("incidents")
}

model IncidentTimeline {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  incidentId  String   @map("incident_id")
  actorId     String?  @map("actor_id")
  actorRole   String?  @map("actor_role")
  action      IncidentTimelineAction @map("action")
  fromStatus  IncidentStatus? @map("from_status")
  toStatus    IncidentStatus? @map("to_status")
  notes       String?  @map("notes")
  evidenceIds String[] @default([]) @map("evidence_ids")
  traceId     String?  @map("trace_id")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  incident    Incident @relation(fields: [incidentId], references: [id])

  @@index([tenantId, incidentId, createdAt(sort: Asc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("incident_timelines")
}

