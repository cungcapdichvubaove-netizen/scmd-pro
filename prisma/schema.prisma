enum ImageStatus {
  PENDING
  ACTIVE
  EXPIRED
  DELETING
  DELETED
  CORRUPTED
}

model Image {
  id          String      @id @default(uuid()) @map("id")
  tenantId    String      @map("tenant_id")
  key         String      @unique @map("key")
  hash        String      @map("hash")
  sizeBytes   BigInt      @map("size_bytes")
  mimeType    String      @map("mime_type")
  status      ImageStatus @default(PENDING) @map("status")
  
  variants    Json?       @map("variants")
  tags        String[]    @default([]) @map("tags")
  
  expiresAt   DateTime?   @map("expires_at")
  deletedAt   DateTime?   @map("deleted_at")
  purgedAt    DateTime?   @map("purged_at")
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([hash, tenantId])
  @@index([tenantId, expiresAt])
  @@map("images")
}

model TenantUsageEvent {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  eventType   String   @map("event_type") // IMAGE_UPLOADED, IMAGE_DELETED
  deltaBytes  BigInt   @map("delta_bytes")
  timestamp   DateTime @default(now()) @map("timestamp")
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@map("tenant_usage_events")
}
