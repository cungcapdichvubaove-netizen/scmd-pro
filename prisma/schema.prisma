  @@index([tenantId, date])
  @@index([contractId])
  @@index([tenantId, guardPostId])
  @@index([date, shiftType])
  @@unique([tenantId, contractId, siteId, guardPostId, date, shiftType, startTime, endTime, positionName])
  @@map("shift_schedules")
}

